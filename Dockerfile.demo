# X402 Demo API Server
# Build: docker build -f Dockerfile.demo -t x402-demo-api .
# Run: docker run -p 3000:3000 x402-demo-api

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY adapters/express/package.json ./package.json
COPY adapters/express/tsconfig.json ./tsconfig.json ./

# Install dependencies
RUN npm install

# Copy source
COPY adapters/express/src ./src
COPY deno ./deno

# Build
RUN npm run build

# Expose port
EXPOSE 3000

# Start
CMD ["node", "dist/index.js"]
